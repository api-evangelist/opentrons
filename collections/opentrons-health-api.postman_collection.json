                "health"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The IP address of the Opentrons robot on the local network",
                  "type": "any",
                  "value": "{{robotIP}}",
                  "key": "robotIP"
                }
              ]
            },
            "header": [
              {
