{
  "opencollection": "1.0.0",
  "info": {
    "name": "Opentrons HTTP Attached Instruments Attached Modules API",
    "version": "4"
  },
  "items": [
    {
      "info": {
        "name": "Attached Modules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get attached modules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{robotIP}:31950/modules",
            "headers": [
              {
                "name": "Opentrons-Version",
                "value": "*"
              }
            ]
          },
          "docs": "Get a list of all hardware modules currently attached to the robot, including thermocyclers, heater-shakers, temperature modules, magnetic modules, and absorbance plate readers."
        }
      ]
    }
  ],
  "bundled": true
}