{
  "opencollection": "1.0.0",
  "info": {
    "name": "Opentrons HTTP Attached Instruments API",
    "version": "4"
  },
  "items": [
    {
      "info": {
        "name": "Attached Instruments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get attached instruments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{robotIP}:31950/instruments",
            "headers": [
              {
                "name": "Opentrons-Version",
                "value": "*"
              }
            ],
            "params": [
              {
                "name": "refresh",
                "value": "",
                "type": "query",
                "description": "If true, refresh the instrument cache before returning"
              }
            ]
          },
          "docs": "Get a list of all instruments (pipettes and gripper) currently attached to the robot."
        }
      ]
    }
  ],
  "bundled": true
}