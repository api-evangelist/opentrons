                  "description": "If true, refresh the instrument cache before returning"
                }
              ],
              "variable": [
                {
                  "description": "The IP address of the Opentrons robot on the local network",
                  "type": "any",
                  "value": "{{robotIP}}",
                  "key": "robotIP"
                }
